RAMP_CLIENT_ID=your_sandbox_client_id
RAMP_CLIENT_SECRET=your_sandbox_client_secret
# CAMP_TOKEN=pick-a-secret   # required when binding beyond 127.0.0.1
CAMP_SANDBOX_GROUP_CAP_CENTS=15000

# Recommender database (Postgres in prod; unset to fall back to the CAMP_DB SQLite file)
CAMP_DATABASE_URL=postgresql://localhost/camp

# AI classifiers (both optional; with neither set an offline keyword mock is used)
# TYPESAFE_API_KEY=your_jev_key       # Jev, the primary classifier
# OPENAI_API_KEY=sk-...               # LLM fallback + "why this pick" text
