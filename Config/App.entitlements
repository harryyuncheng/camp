<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Live Activity push (update + push-to-start) needs the Push Notifications capability, which a
	     free Apple Developer team cannot enable, so wiring it in is opt-in via Config/Local.xcconfig:
	       CAMP_PUSH_ENTITLEMENTS = Config/App.entitlements
	       SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CAMP_PUSH
	     The app target's CODE_SIGN_ENTITLEMENTS already reads $(CAMP_PUSH_ENTITLEMENTS) (empty by
	     default). The backend also needs CAMP_APNS_KEY / _KEY_ID / _TEAM_ID / _BUNDLE_ID.
	     Xcode's Automatic signing rewrites "development" to "production" for a distribution build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
