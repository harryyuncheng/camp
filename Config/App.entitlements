<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- NOT WIRED IN. Live Activity push-to-update needs the Push Notifications capability, which a free
	     Apple Developer team cannot enable, so referencing this file from CODE_SIGN_ENTITLEMENTS would
	     break device builds. To turn push-to-update on once the team is paid:
	       1. add CODE_SIGN_ENTITLEMENTS = Config/App.entitlements to both Lunchline app configs
	       2. flip LunchController.pushToUpdateEnabled to true
	       3. set CAMP_APNS_KEY / _KEY_ID / _TEAM_ID / _BUNDLE_ID on the backend
	     Xcode's Automatic signing rewrites "development" to "production" for a distribution build. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
