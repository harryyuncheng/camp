// Set the same team on both targets in Xcode's Signing & Capabilities tab.
// Change this prefix once to give both targets unique bundle identifiers.
BUNDLE_ID_PREFIX = com.example.camp
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
TARGETED_DEVICE_FAMILY = 1
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO

// Real-time Live Activity updates while camp is backgrounded (APNs push-to-update and push-to-start)
// need the Push Notifications capability, which a free Apple Developer team cannot sign. To enable,
// set this to Config/App.entitlements in Local.xcconfig together with the CAMP_PUSH flag documented
// in Local.xcconfig.example. Empty keeps every build signable without push.
CAMP_PUSH_ENTITLEMENTS =

// Optional machine-local signing overrides (never committed).
#include? "Local.xcconfig"
